# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database ---
MONGO_URI=mongodb://127.0.0.1:27017/Our_web_trackflix

# --- Firebase Admin (pick ONE) ---
# 1) Paste the whole service-account JSON on one line (recommended for Render/Docker):
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account", ...}
# 2) Or place serviceAccountKey.json in this folder (it is git-ignored).

# --- Security ---
# Comma-separated emails allowed to use admin endpoints. If empty, nobody is admin.
ADMIN_EMAILS=you@example.com
# Comma-separated frontend origins allowed by CORS. If empty, all origins are allowed (dev only).
CORS_ORIGINS=http://localhost:5173
